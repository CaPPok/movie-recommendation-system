# Biến môi trường cho các script nói chuyện với AWS.
#
# Repo này KHÔNG tự đọc file .env -- không có python-dotenv, và cố ý như vậy:
# pipeline dữ liệu, train, evaluate và inference đều chạy được khi không có AWS
# và không có boto3, nên không thứ gì trong luồng đó được phép phụ thuộc vào một
# file cấu hình môi trường.
#
# Nạp bằng:  .\load_env.ps1
#
# Mọi giá trị ở đây cũng có thể đặt trong configs/aws.yaml; biến môi trường
# thắng, để cùng một file YAML dùng được cho laptop, Processing Job và EC2.

AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1

MOVIE_REC_BUCKET=REPLACE_BUCKET

# Role thực thi cho SageMaker. Kiểm tra `aws iam get-role --role-name <tên>` xem
# PermissionsBoundary có phải null không trước khi dùng -- một boundary chỉ cho
# S3 sẽ khiến job và endpoint chết mà không sinh ra log nào.
MOVIE_REC_SAGEMAKER_ROLE=arn:aws:iam::REPLACE_ACCOUNT_ID:role/service-role/REPLACE_ROLE_NAME

# SDK sagemaker v2 in cảnh báo deprecation ở mọi lệnh; tắt cho log dễ đọc.
SAGEMAKER_SUPPRESS_V2_WARNING=1
