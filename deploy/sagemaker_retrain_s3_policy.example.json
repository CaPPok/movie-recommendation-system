{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteArtifactsAndReports",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/*"
    },
    {
      "Sid": "EncryptBucketObjects",
      "Effect": "Allow",
      "Action": ["kms:GenerateDataKey"],
      "Resource": "arn:aws:kms:REPLACE_REGION:REPLACE_ACCOUNT_ID:key/REPLACE_KMS_KEY_ID"
    }
  ]
}
